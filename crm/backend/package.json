{
    "name": "@aranax/backend",
    "version": "1.0.0",
    "private": true,
    "description": "Aranax Technologies lead capture, CRM, pipeline and revenue analytics REST API",
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
        "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
        "db:seed:countries": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/countries.sql",
        "db:seed:demo": "tsx --env-file-if-exists=.env src/db/seed-demo.ts",
        "db:seed:demo:cleanup": "tsx --env-file-if-exists=.env src/db/seed-demo.ts --cleanup",
        "openapi:export": "tsx --env-file-if-exists=.env src/scripts/export-openapi.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:all": "vitest run",
        "worker": "node --env-file-if-exists=.env dist/worker.js"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.10.0",
        "@aranax/contracts": "workspace:*",
        "@fastify/cors": "^11.4.2",
        "@fastify/helmet": "^13.2.0",
        "@fastify/jwt": "^10.2.7",
        "@fastify/rate-limit": "^11.2.2",
        "@fastify/swagger": "^9.9.3",
        "@fastify/swagger-ui": "^6.1.3",
        "decimal.js": "^10.6.0",
        "drizzle-orm": "^0.45.4",
        "fastify": "^5.12.8",
        "fastify-plugin": "^5.1.0",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "nodemailer": "^10.5.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "pino-pretty": "^13.2.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    }
}
