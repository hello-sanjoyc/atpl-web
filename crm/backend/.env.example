NODE_ENV=development
PORT=4000
HOST=0.0.0.0
TRUST_PROXY=false
BODY_LIMIT_BYTES=262144
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3005,http://localhost:5173

DATABASE_URL=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_SLOW_QUERY_MS=500
DB_QUERY_LOGGING=false

# Optional. Enables Redis-backed rate-limit counters shared across PM2 instances.
REDIS_URL=redis://localhost:6379

JWT_SECRET=
JWT_ACCESS_TTL=12h
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
PUBLIC_RATE_LIMIT_MAX=30

# Email is disabled (queued events wait) until SMTP is configured.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=aranaxtech@gmail.com
SMTP_PASSWORD=
SMTP_FROM="Aranax Technologies"
SALES_NOTIFICATION_EMAIL=aranaxtech@gmail.com

# AI / LLM — set ANTHROPIC_API_KEY to enable all AI features (env fallback).
# The active provider is managed in Settings → LLM (stored encrypted in DB).
# Without any configuration the system runs in graceful-degradation mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2048
# Secret used to AES-256-GCM encrypt LLM API keys stored in the DB (must be ≥32 chars).
LLM_ENCRYPTION_SECRET=change-me-to-a-secure-32-char-secret!

# none | hubspot. CRM sync is recorded as "skipped" when none.
CRM_PROVIDER=none
HUBSPOT_ACCESS_TOKEN=

# none | calendly. Webhooks are rejected when none.
BOOKING_PROVIDER=none
BOOKING_URL=
BOOKING_WEBHOOK_SECRET=
BOOKING_WEBHOOK_TOLERANCE_SECONDS=300

DEFAULT_CURRENCY=INR
REPORTING_TIMEZONE=UTC

LOG_LEVEL=info
LOG_FORMAT=json
LOG_PRETTY=false
LOG_REDACTION=true
LOG_SERVICE_NAME=aranax-lead-api
LOG_ENVIRONMENT=development
LOG_INCLUDE_STACK=false
APP_VERSION=1.0.0

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=8
SCHEDULER_INTERVAL_MS=300000
SHUTDOWN_TIMEOUT_MS=15000

# Optional: first administrator, created by `pnpm db:seed` only if absent.
SEED_ADMIN_EMAIL=sany.chowdhury@gmail.com
SEED_ADMIN_PASSWORD=
