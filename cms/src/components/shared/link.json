{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "Link",
    "description": "Reusable navigation or call-to-action link"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string",
      "required": true
    },
