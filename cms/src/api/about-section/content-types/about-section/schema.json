{
  "kind": "collectionType",
  "collectionName": "about_sections",
  "info": {
    "singularName": "about-section",
    "pluralName": "about-sections",
    "displayName": "About Section",
    "description": "Homepage company story, statistics, and featured team"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "eyebrow": { "type": "string", "required": true },
    "heading": { "type": "text", "required": true },
    "description": { "type": "text", "required": true },
    "teamHeading": { "type": "string", "required": true },
    "statistics": {
      "type": "component",
      "repeatable": true,
      "component": "shared.statistic",
      "required": true,
      "min": 1
    },
    "teamMembers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team-member.team-member"
    },
    "pageContent": { "type": "json", "required": true },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    }
  }
}
