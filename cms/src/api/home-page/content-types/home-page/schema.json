{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Editable landing-page section content and featured entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "config": {
    "settings": {
      "bulkable": true,
      "filterable": true,
      "searchable": true,
      "pageSize": 10,
      "mainField": "title",
      "defaultSortBy": "title",
      "defaultSortOrder": "ASC",
      "relationOpenMode": "modal"
    }
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "default": "Homepage"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true
    },
    "heroSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::hero-section.hero-section"
    },
    "servicesSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::services-section.services-section"
    },
    "whyAranaxSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::why-aranax-section.why-aranax-section"
    },
    "caseStudiesSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::case-studies-section.case-studies-section"
    },
    "aboutSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::about-section.about-section"
    },
    "contactSection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contact-section.contact-section"
    },
    "buyerSegments": { "type": "json", "required": true },
    "processSection": { "type": "json", "required": true },
    "faqSection": { "type": "json", "required": true },
    "finalCta": { "type": "json", "required": true }
  }
}
