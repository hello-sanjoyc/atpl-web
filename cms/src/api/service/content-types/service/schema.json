{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Services shown in the What We Build section"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "number": {
      "type": "string",
      "required": true,
      "maxLength": 3
    },
    "description": {
      "type": "text",
      "required": true
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "required": true,
      "min": 1
    },
    "icon": {
      "type": "enumeration",
      "enum": ["spark", "chat", "grid"],
      "required": true
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    }
  }
}
