{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study",
    "description": "Project case studies displayed on the landing page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "tagline": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "challenge": {
      "type": "text",
      "required": true
    },
    "outcome": {
      "type": "text",
      "required": true
    },
    "contribution": {
      "type": "text",
      "required": true
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item",
      "required": true,
      "min": 1
    },
    "websiteUrl": {
      "type": "string",
      "required": true
    },
    "visual": {
      "type": "enumeration",
      "enum": ["ema", "docunova", "uniecho", "doubtace", "gloziia", "glamsync"],
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": false
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    "pageContent": { "type": "json", "required": true }
  }
}
