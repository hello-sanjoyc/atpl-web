# =========================================================
# Dependencies
# =========================================================

web/node_modules/
cms/node_modules/
crm/node_modules/
crm/backend/node_modules/
crm/frontend/node_modules/
crm/shared/node_modules/
node_modules/

# =========================================================
# PNPM
# =========================================================

.pnpm-store/
web/.pnpm-store/
cms/.pnpm-store/
crm/.pnpm-store/

pnpm-debug.log*
debug.log*

# IMPORTANT:
# Do NOT ignore pnpm-lock.yaml.
# Lockfiles should be committed.


# =========================================================
# Environment variables
# =========================================================

# Environment files
.env
.env.*
**/.env
**/.env.*

# Allow example env files
!.env.example
!**/.env.example


# =========================================================
# Next.js - web/
# =========================================================

web/.next/
web/out/
web/dist/

# Next.js generated TypeScript declarations
web/next-env.d.ts

# Vercel
web/.vercel/

# Next.js / Node cache
web/.cache/

# Testing / coverage
web/coverage/

# TypeScript incremental build
web/*.tsbuildinfo


# =========================================================
# Strapi - cms/
# =========================================================

# Strapi cache/temp
cms/.cache/
cms/.tmp/
cms/.strapi/
cms/.strapi-updater.json

# Build output
cms/build/
cms/dist/


# =========================================================
# Strapi uploaded media
# =========================================================

cms/public/uploads/*
!cms/public/uploads/.gitkeep


# =========================================================
# CRM - crm/ (backend, frontend, shared)
# =========================================================

# Build output
crm/backend/dist/
crm/frontend/dist/
crm/shared/dist/

# Vite / frontend cache
crm/frontend/.vite/

# Demo/seed credentials generated locally
crm/**/.demo-credentials.json


# =========================================================
# Logs
# =========================================================

*.log

web/logs/
cms/logs/
crm/logs/
crm/backend/logs/
crm/frontend/logs/


# =========================================================
