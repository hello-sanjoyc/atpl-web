# Internal server-to-server Strapi URL. Keep this private in production.
STRAPI_URL=http://127.0.0.1:1337

# Public origin used for media URLs returned to the browser.
# Optional override. Development defaults to STRAPI_URL; production defaults to https://cms.aranax.tech.
# STRAPI_PUBLIC_URL=http://127.0.0.1:1337

# Optional. Recommended if public read access is disabled in Strapi.
STRAPI_API_TOKEN=

# Must match NEXT_REVALIDATION_SECRET in Strapi if on-demand route
# revalidation is used for other cached content.
CMS_REVALIDATE_SECRET=replace-with-a-long-random-secret

# Internal server-to-server CRM backend URL. Used to submit contact form
# leads to the CRM's public lead-capture API. Keep this private in production.
CRM_API_URL=http://127.0.0.1:4000

# Version string recorded against each lead's consent, e.g. the date the
# current privacy policy was published. Must be updated whenever the
# published privacy policy changes.
CRM_PRIVACY_POLICY_VERSION=2025-01-v1
